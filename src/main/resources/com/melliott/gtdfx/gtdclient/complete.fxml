<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.melliott.gtdfx.gtdclient.CompleteController">
    <TableView fx:id="tbNext" prefHeight="311.0" prefWidth="600.0" styleClass="complete-table"
               stylesheets="@../../../../css/style.css" AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <columns>
            <TableColumn fx:id="colCreated" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="Created"/>
            <TableColumn fx:id="colFinished" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="Finished"/>
            <TableColumn fx:id="colElapsed" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="Elapsed"/>
            <TableColumn fx:id="colDescNext" prefWidth="75.0" text="Description"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER_RIGHT" prefHeight="35.0" prefWidth="200.0" spacing="8.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
        </padding>
        <Button fx:id="btnUndo" mnemonicParsing="false" onAction="#undoTask" text="Undo Completion"/>
    </HBox>
</AnchorPane>
