<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
            prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.melliott.gtdfx.gtdclient.controller.GtdController">
    <MenuBar AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false" text="Close"/>
        </Menu>
        <Menu mnemonicParsing="false" text="Edit">
            <MenuItem mnemonicParsing="false" text="Delete"/>
        </Menu>
        <Menu mnemonicParsing="false" text="Help">
            <MenuItem mnemonicParsing="false" text="About"/>
        </Menu>
    </MenuBar>
    <BorderPane prefHeight="25.0" prefWidth="200.0"
                style="-fx-border-style: solid line-join bevel; -fx-border-color: lightgray darkgray darkgray lightgray;"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <left>
            <Label text="Connected to: Local" BorderPane.alignment="CENTER" fx:id="lbLeft"/>
        </left>
        <right>
            <Label text="Tasks loaded" BorderPane.alignment="CENTER" fx:id="lbRight"/>
        </right>
        <padding>
            <Insets left="8.0" right="8.0"/>
        </padding>
    </BorderPane>
    <TabPane fx:id="tabPane" layoutY="25.0" prefHeight="375.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE"
             AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
             AnchorPane.topAnchor="25.0">
        <Tab fx:id="tabInbox" text="Inbox">
            <AnchorPane fx:id="inboxContainer"/>
        </Tab>
        <Tab fx:id="tabNext" text="Next">
            <AnchorPane fx:id="nextContainer"/>
        </Tab>
        <Tab fx:id="tabWaiting" text="Waiting">
            <AnchorPane fx:id="waitingContainer"/>
        </Tab>
        <Tab fx:id="tabProjects" text="Projects">
            <AnchorPane fx:id="projectsContainer"/>
        </Tab>
        <Tab fx:id="tabSomeday" text="Someday">
            <AnchorPane fx:id="somedayContainer"/>
        </Tab>
        <Tab fx:id="tabComplete" text="Completed">
            <AnchorPane fx:id="completeContainer"/>
        </Tab>
    </TabPane>
</AnchorPane>
