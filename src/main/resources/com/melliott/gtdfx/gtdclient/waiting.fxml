<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.melliott.gtdfx.gtdclient.controller.WaitingController">
    <TableView fx:id="tbTasks" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSinceNext" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="Created"/>
            <TableColumn fx:id="colDescNext" prefWidth="75.0" text="Description"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <VBox fx:id="notesBox" spacing="8.0" VBox.vgrow="NEVER">
        <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
        </padding>
        <Label text="Notes"/>
        <TextArea fx:id="taNotes" prefHeight="200.0" prefWidth="200.0"/>
    </VBox>
</VBox>
