<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.melliott.gtdfx.gtdclient.controller.InboxController">
    <TableView fx:id="tbTasks" prefHeight="311.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSince" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="Created"/>
            <TableColumn fx:id="colDesc" prefWidth="75.0" text="Description"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER_RIGHT" prefHeight="35.0" prefWidth="200.0" spacing="8.0" VBox.vgrow="NEVER">
        <padding>
            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
        </padding>
        <TextField fx:id="tfNewTask" promptText="What's on your mind?" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAdd" mnemonicParsing="false" text="ADD"/>
    </HBox>
</VBox>
